# KavachNet / CrimeNet Environment Configuration Template
# Duplicate this file as .env for local overrides. Never commit real production secrets to Git.

PROJECT_NAME=KavachNet
API_V1_STR=/api/v1

# JWT Authentication
JWT_SECRET_KEY=kavachnet-dev-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Secure External Provider Integration
OFFICIAL_PROVIDER_CLIENT_ID=CRIMENET-DEL-HQ
OFFICIAL_PROVIDER_SHARED_SECRET=kavachnet-official-shared-secret-key-2026
OFFICIAL_PROVIDER_BASE_URL=https://mock-official-provider.internal
CHALLENGE_TIMEOUT_SECONDS=120

# Database Connections (Prototype defaults)
DATABASE_URL=postgresql://kavachnet:kavachnet@localhost:5432/kavachnet
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kavachnet2026
